# This file uses @env-spec syntax and is safe to commit.
# Selects the Varlock profile. Common Deno tasks set DEV_ENV=jb inline so
# fresh clones do not need a gitignored .env.local selector.
#
# @defaultSensitive=false @defaultRequired=false @currentEnv=$DEV_ENV
# ---

# Local development profile selector.
# @type=enum(development, jb, test, production) @sensitive=false
DEV_ENV=development

# PlanetScale database host used by the optional integration tests.
# @type=string(minLength=1) @sensitive=false
PLANETSCALE_HOST=

# PlanetScale database username used by the optional integration tests.
# On JB macOS machines, the committed .env.jb profile currently uses the
# jb-dev-env exec(security) fallback for account:
# deno_curry_cache:jb:PLANETSCALE_USER
# Current Varlock keychain(prompt) only titles the picker with this env var name,
# so use the explicit scoped account reference instead of relying on prompt mode.
# If label/comment metadata is not supported, the account identifier carries
# the project scope. Add this repo path as metadata when supported:
# /Users/bjesuiter/Develop/codemonument/deno_curry_cache
# @sensitive @type=string(minLength=1)
PLANETSCALE_USER=

# PlanetScale database password used by the optional integration tests.
# On JB macOS machines, the committed .env.jb profile currently uses the
# jb-dev-env exec(security) fallback for account:
# deno_curry_cache:jb:PLANETSCALE_PASSWD
# Current Varlock keychain(prompt) only titles the picker with this env var name,
# so use the explicit scoped account reference instead of relying on prompt mode.
# If label/comment metadata is not supported, the account identifier carries
# the project scope. Add this repo path as metadata when supported:
# /Users/bjesuiter/Develop/codemonument/deno_curry_cache
# @sensitive @type=string(minLength=1)
PLANETSCALE_PASSWD=
