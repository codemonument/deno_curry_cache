# JB local development profile. This file is safe to commit because it contains
# resolver references, not plaintext secrets. Select it locally with:
# .env.local => DEV_ENV=jb
#
# Keychain service: varlock
# Keychain account pattern: deno_curry_cache:jb:<ENV_VAR_NAME>
# Repo path for Keychain item label/comment metadata when supported:
# /Users/bjesuiter/Develop/codemonument/deno_curry_cache
#
# Current Varlock keychain(prompt) cannot customize the picker heading/title; it
# only passes the exported env var key. Use explicit scoped account references.
# This profile currently uses the jb-dev-env exec(security) fallback because
# Varlock-native keychain(...) could not read the seeded items.

# Optional PlanetScale host for JB local integration tests. Leave empty to keep
# PlanetScale tests skipped unless supplied through another local/private source.
PLANETSCALE_HOST=

PLANETSCALE_USER=exec("security find-generic-password -s varlock -a \"deno_curry_cache:jb:PLANETSCALE_USER\" -w")
PLANETSCALE_PASSWD=exec("security find-generic-password -s varlock -a \"deno_curry_cache:jb:PLANETSCALE_PASSWD\" -w")
